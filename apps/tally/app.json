{
    "expo": {
        "name": "tally",
        "slug": "tally",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "userInterfaceStyle": "light",
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.anonymous.tally"
        },
        "android": {
            "plugins": [
                [
                    "expo-build-properties",
                    {
                        "android": {
                            "abiFilters": [
                                "arm64-v8a",
                                "armeabi-v7a"
                            ]
                        }
                    }
                ]
            ],
            "adaptiveIcon": {
                "backgroundColor": "#E6F4FE",
                "foregroundImage": "./assets/android-icon-foreground.png",
                "backgroundImage": "./assets/android-icon-background.png"
            },
            "package": "com.eitanoid.tally"
        },
        "web": {
            "favicon": "./assets/favicon.png"
        },
        "extra": {
            "eas": {
                "projectId": "823a7058-ae72-47fd-ba87-3cd09420fb0b"
            }
        },
        "plugins": [
            "expo-secure-store",
            {
                "configureAndroidBackup": true
            }
        ]
    }
}
